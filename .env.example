# ============================================================
#  Vault-ZeroBaran — Environment Configuration Template
#  Copy this file to ".env" and fill in your real values.
#  Every key below uses a FREE tier — no payment required.
# ============================================================

# --- Google Gemini API (Free Tier) ---
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash

# --- Groq API (Optional free-tier fallback for chat) ---
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# --- Supabase (Free Tier) ---
# Create project: https://supabase.com
# Project URL looks like: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
# For direct pgvector operations (recommended):
SUPABASE_DB_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# --- Telegram Bot (Optional) ---
# Talk to @BotFather on Telegram to create a bot and get its token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_personal_chat_id_here

# --- Vault Settings ---
VAULT_DATA_DIR=./data/uploads
VAULT_CHUNK_SIZE=1000
VAULT_CHUNK_OVERLAP=200
VAULT_TOP_K=5                  # Number of chunks retrieved per query
VAULT_MAX_TOKENS=2048          # Max tokens for chat completion
VAULT_LANGUAGE=ar              # Default response language (ar/en)
VAULT_TEMPERATURE=0.2          # Low temperature = deterministic answers

# --- Copyright / Owner (filled by author of Vault-ZeroBaran) ---
OWNER_NAME=Baran Avisat
OWNER_EMAIL=Baranavisat@gmail.com
OWNER_HANDLE=00905313263722
