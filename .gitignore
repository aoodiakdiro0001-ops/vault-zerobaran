__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing / coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Streamlit
.streamlit/

# Project data — keep folder but ignore contents
data/uploads/*
!data/uploads/.gitkeep

# OS
Thumbs.db
ehthumbs.db
desktop.ini

# Docker
*.log
